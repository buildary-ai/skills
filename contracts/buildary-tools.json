    {
      "name": "create_upload",
      "annotations": {
        "title": "Start a file upload",
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "size": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 52428800
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mimeType": {
            "type": "string",
            "enum": [
              "video/mp4",
              "video/quicktime",
              "audio/mpeg",
              "audio/wav",
              "image/jpeg",
              "image/png",
              "image/webp",
              "image/heic",
              "image/heif",
              "image/bmp",
              "image/tiff",
              "image/gif"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "size",
          "sha256",
          "mimeType",
          "filename"
        ],
        "additionalProperties": false
      }
    },
    {
